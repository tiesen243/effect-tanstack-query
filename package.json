{
  "name": "@tiesen/effect-tanstack-query",
  "version": "0.0.3",
  "private": false,
  "keywords": [
    "effect",
    "tanstack-intent",
    "typesafe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/effect-tanstack-query.git"
  },
  "files": [
