    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tegami": "^1.2.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.100.0",
    "effect": ">=4.0.0-beta.100 || >=4.0.0"
